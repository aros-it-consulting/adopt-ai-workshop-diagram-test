{
  "type": "object",
  "properties": {
    "1": {"type": "integer"},
    "2": {"$ref": "#/$defs/rules"},
    "3": {"$ref": "#/$defs/rules"},
    "4": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "enum": ["section", "annex", "article"]},
          "number": {"type": "string", "pattern": "^[0-9A-Z]+(\\.[0-9]+)*$"}
        },
        "required": ["kind", "number"],
        "additionalProperties": false
      }
    }
  },
  "required": ["1", "2", "3", "4"],
  "additionalProperties": false,
  "$defs": {
    "rules": {"type": "array", "items": {"type": "string", "pattern": "^RG-[0-9]{2}$"}}
  }
}
